# Les polices sont émises par next/font sous /_next/static/media : la règle ci-dessous les couvre.
# Une seconde règle /fonts/* a existé ici alors que public/fonts/ n'a jamais existé — vérifié en
# production, c'est bien /_next/static/* qui pose le immutable sur les .woff2 servis.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
