{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // nodejs_compat: required by OpenNext, and it backs node:crypto + process.env in the booking code.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-booking",
      "database_id": "b9206700-92af-4782-9c71-a17b2a464ced"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
