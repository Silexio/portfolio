{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // nodejs_compat: required by OpenNext, and it backs node:crypto + process.env in the booking code.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-booking",
      "database_id": "b9206700-92af-4782-9c71-a17b2a464ced",
    },
  ],
  "env": {
    // Déploiement de préproduction : même code, autre Worker, autre base. Les branches autres que
    // `main` doivent se déployer ici (Workers Builds → contrôle des branches → `--env preview`),
    // sinon un push sur `dev` remplace la production, ce qui est arrivé.
    "preview": {
      "name": "portfolio-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portfolio-booking-preview",
          "database_id": "c4394d6d-c72c-4da2-bf35-927ae2647b65",
        },
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
