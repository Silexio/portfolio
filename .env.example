# Variables locales (dev). En production, ce sont des secrets Workers :
#   wrangler secret put <NOM>
# La base D1 n'a pas d'URL : elle arrive par le binding "DB" déclaré dans wrangler.jsonc.

# ── Base ──────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://silexio.be"

# ── Cloudflare Turnstile (anti-bot) ───────────────────────────
# Clés de test Cloudflare (toujours valides) pour le dev :
#   site:  1x00000000000000000000AA  · secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ── Emails transactionnels (API HTTP Brevo) ───────────────────
# Clé API : Brevo → SMTP & API → API keys.
BREVO_API_KEY="xkeysib-changeme"
# Expéditeur : doit être un sender vérifié dans Brevo.
BREVO_SENDER_EMAIL="no-reply@silexio.be"
# Destinataire des demandes de RDV (propriétaire).
BOOKING_NOTIFY_EMAIL="contact@silexio.be"

# ── Agenda : blocage des créneaux déjà pris (facultatif) ──────
# URL iCalendar en lecture seule d'un agenda publié. Sans elle, la synchro est
# inactive : seules les demandes déjà reçues grisent des créneaux.
# kCalendar (Infomaniak) : ouvrir l'agenda → Partager publiquement → copier l'URL.
#   forme : https://sync.infomaniak.com/calendars/<compte>/<uuid>?export
# Plusieurs agendas : séparer par des virgules.
# Donne accès en lecture aux titres des rendez-vous : garder secret, ne jamais
# committer, régénérer depuis kCalendar en cas de fuite.
BOOKING_CALENDAR_ICS_URL="https://sync.infomaniak.com/calendars/<compte>/<uuid>?export"
BOOKING_CALENDAR_AUTH="ton-identifiant:le-mot-de-passe-application"

# ── Suivi des erreurs (Bugsink self-hosted, protocole Sentry) ─
# Inerte sans DSN. Même valeur des deux côtés (client + serveur).
# Toujours en https : un DSN http finit sur un 301 que les SDK Sentry ne suivent pas.
NEXT_PUBLIC_SENTRY_DSN="https://<cle>@sentry.silexio.be/<projet>"
SENTRY_DSN="https://<cle>@sentry.silexio.be/<projet>"
# Upload des source maps au build (facultatif) : sans SENTRY_AUTH_TOKEN, l'étape est ignorée.
SENTRY_URL="https://sentry.silexio.be"
SENTRY_ORG="silexio"
SENTRY_PROJECT="portfolio"
SENTRY_AUTH_TOKEN=""

# ── Secrets (générer : openssl rand -hex 32) ──────────────────
# Signe les liens confirmer/refuser des emails.
BOOKING_ACTION_SECRET="change-me-32-bytes-hex"
# Hash des IP pour le rate limit (RGPD : jamais d'IP en clair).
IP_HASH_SECRET="change-me-32-bytes-hex"
